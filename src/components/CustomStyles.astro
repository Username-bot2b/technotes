---
// Craigslist-inspired brutalist theme tokens
---

<style is:inline>
  :root {
    --aw-font-sans: Arial, Helvetica, sans-serif;
    --aw-font-serif: Times, 'Times New Roman', Georgia, serif;
    --aw-font-heading: Arial, Helvetica, sans-serif;

    --aw-color-primary: #000000;
    --aw-color-secondary: #666666;
    --aw-color-accent: #00e;

    --aw-color-text-heading: #000000;
    --aw-color-text-default: #000000;
    --aw-color-text-muted: #666666;
    --aw-color-bg-page: #ffffff;

    --aw-color-bg-page-dark: #ffffff;

    ::selection {
      background-color: #000000;
      color: #ffffff;
    }
  }

  .dark {
    --aw-font-sans: Arial, Helvetica, sans-serif;
    --aw-font-serif: Times, 'Times New Roman', Georgia, serif;
    --aw-font-heading: Arial, Helvetica, sans-serif;

    --aw-color-primary: #000000;
    --aw-color-secondary: #666666;
    --aw-color-accent: #00e;

    --aw-color-text-heading: #000000;
    --aw-color-text-default: #000000;
    --aw-color-text-muted: #666666;
    --aw-color-bg-page: #ffffff;

    ::selection {
      background-color: #000000;
      color: #ffffff;
    }
  }

  html {
    font-family: var(--aw-font-serif);
    font-size: 16px;
    line-height: 1.4;
    letter-spacing: 0;
  }
</style>
