{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/giscus-brutal.css",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://giscus.app"
        }
      ]
    }
  ]
}
